# Don't edit by hand - run:  python -m kbot setup
# It fills these in and stores your private key(s) under keys/ with owner-only permissions.
# Never commit .env or keys/. Never paste a private key into a chat.
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_KEY_PATH=keys/kalshi-demo.pem
# Optional: production key, used READ-ONLY for recording real books + the settlement index
KALSHI_PROD_KEY_ID=
KALSHI_PROD_KEY_PATH=keys/kalshi-prod.pem
# Optional alerts (kill switch, data gaps, fee mismatch, daily summary). Slack/Discord webhook URL, and/or Telegram:
KBOT_ALERT_WEBHOOK=
KBOT_TELEGRAM_TOKEN=
KBOT_TELEGRAM_CHAT=

# --- pbot (Public.com day-trading bot) - filled in by:  python -m pbot setup ---
PUBLIC_API_SECRET=
PUBLIC_ACCOUNT_ID=
# Optional Slack/Discord webhook for entries, exits and halts
PBOT_ALERT_WEBHOOK=
